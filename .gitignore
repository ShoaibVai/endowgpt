# endowGPT ships its deployment config; the nested upstream .gitignore
# ignores these names, and the negation must live in the same file to win.
!LibreChat-main/librechat.yaml
!LibreChat-main/librechat.yml

# --- Legacy plans (not authoritative) ---
setup-guide.md
FINAL_REPORT.md

# --- Runtime / data volumes ---
# Anchored to the repository root on purpose: an unanchored `images/` also
# matched LibreChat-main/packages/api/src/images/, which is source and is
# imported by packages/api/src/index.ts. Unanchored patterns here break the
# image build on a fresh clone.
/data-node/
/meili_data*
/pgdata*
/vectors/
/uploads/
/images/
/logs/
/skill/
LibreChat-main/data-node/
LibreChat-main/meili_data*/
LibreChat-main/uploads/
LibreChat-main/images/
LibreChat-main/logs/
LibreChat-main/skill/

# Source directories that merely share a runtime directory name.
# Without these the Docker build fails: `Could not resolve './images'`.
!LibreChat-main/packages/api/src/images/
!LibreChat-main/api/server/services/Files/images/
LibreChat-main/client/public/images/*
!LibreChat-main/client/public/images/.gitkeep
LibreChat-main/client/public/fonts/
LibreChat-main/client/public/assets/custom-themes/

# --- Node / build ---
node_modules/
dist/
build/
coverage/
LibreChat-main/client/dist/
LibreChat-main/client/node_modules/
*.tsbuildinfo

# --- Logs / temp ---
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# --- Editor ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
scripts/.brand-derived/
