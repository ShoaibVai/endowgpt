# =============================================================================
# endowGPT environment template
# =============================================================================
#   cp .env.example .env     (then fill in real values)
#
# `.env` is git-ignored and is never committed. Every variable used by the
# endowGPT stack is documented below. Values marked **generate** must be
# unique, random secrets (e.g. `openssl rand -base64 48`).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core app
# -----------------------------------------------------------------------------
# Human-facing application name (browser tab, PWA install prompt, login page).
APP_TITLE=endowGPT

# Port the endowGPT API/SPA listens on, in the container and on the host.
PORT=3080

# Reachable URL of the server and of the client, as the browser sees them.
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080

# Node runtime mode inside the container.
NODE_ENV=production

# Linux container uid:gid for file ownership (ignored on Docker Desktop/macOS,
# useful on Linux hosts with bind-mounted data).
# UID=1000
# GID=1000

# -----------------------------------------------------------------------------
# 2. Security (all **generate**, never share or commit)
# -----------------------------------------------------------------------------
# Secret used to sign end-user JWT tokens.
JWT_SECRET=

# Secret used to sign refresh tokens.
JWT_REFRESH_SECRET=

# Secret used for express-session cookies.
SESSION_SECRET=

# AES key for encrypting user-supplied provider credentials. Exactly 64 hex chars.
CREDS_KEY=

# AES initialization vector for the same crypto. Exactly 32 hex chars.
CREDS_IV=

# -----------------------------------------------------------------------------
# 3. Models (endowGPT inference)
# -----------------------------------------------------------------------------
# The ONLY model credential the app needs. Read by librechat.yaml as ${OPENCODE_API_KEY}.
OPENCODE_API_KEY=

# Model id used for title generation and other cheap utility calls.
# (Utility use is also pinned in librechat.yaml; changing it here does not
#  change librechat.yaml unless you edit that file too.)
ENDOWGPT_DEFAULT_MODEL=deepseek-v4.1-flash-free

# -----------------------------------------------------------------------------
# 4. Branding / UI
# -----------------------------------------------------------------------------
# Runtime footer HTML shown under the chat composer. Must start with a tag;
# script tags are stripped. Other surface customizations (splash toggle,
# document editor limits, theme tokens) live in librechat.yaml.
CUSTOM_FOOTER=© 2026 endowGPT · <a href="/credits" class="underline">Credits &amp; licenses</a>

# -----------------------------------------------------------------------------
# 5. Auth
# -----------------------------------------------------------------------------
# Allow new users to register (set false after onboarding for a closed instance).
ALLOW_REGISTRATION=true

# Allow email + password login.
ALLOW_EMAIL_LOGIN=true

# Social/OAuth logins stay off in this deployment.
ALLOW_SOCIAL_LOGIN=false

# Allow "forgot password" email flow (requires SMTP settings; off by default).
ALLOW_PASSWORD_RESET=false

# -----------------------------------------------------------------------------
# 6. Database
# -----------------------------------------------------------------------------
# MongoDB used for users, conversations, messages, and documents.
MONGO_URI=mongodb://mongodb:27017/LibreChat

# -----------------------------------------------------------------------------
# 7. Meilisearch (conversation search)
# -----------------------------------------------------------------------------
# Enable the search endpoints and Index UI.
SEARCH=true

# **generate** Master key for Meilisearch. Must match what meilisearch runs with.
MEILI_MASTER_KEY=

# Meilisearch analytics off by default.
MEILI_NO_ANALYTICS=true

# -----------------------------------------------------------------------------
# 8. RAG (file search / citations)
# -----------------------------------------------------------------------------
# Internal URL LibreChat uses to reach the RAG API.
RAG_API_URL=http://rag_api:8000

# Port inside the compose network (keep 8000 unless collision).
RAG_PORT=8000

# Local directory RAG uploads land in (container path is fixed by compose).
RAG_UPLOAD_DIR=/app/uploads/

# ---- Embeddings ----
# Provider: ollama (default for endowGPT; no external API required)
EMBEDDINGS_PROVIDER=ollama

# Ollama embedding model, pulled automatically by the ollama-init service.
EMBEDDINGS_MODEL=nomic-embed-text

# Where the RAG API finds Ollama.
OLLAMA_BASE_URL=http://ollama:11434

# ---- Vector store (pgvector) ----
VECTOR_DB_TYPE=pgvector
POSTGRES_DB=endowgpt
POSTGRES_USER=endowgpt
POSTGRES_PASSWORD=

# Connection details used by the RAG API to reach vectordb.
DB_HOST=vectordb
DB_PORT=5432

# Chunking / retrieval tuning.
CHUNK_SIZE=1500
CHUNK_OVERLAP=100
RAG_DISTANCE_THRESHOLD=

# -----------------------------------------------------------------------------
# 9. Proxies (optional)
# -----------------------------------------------------------------------------
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1,::1
